# Example environment configuration
# Copy this file to .env.dev or .env.prod and update values.

# Runtime
HOST=127.0.0.1
PORT=5000
DEBUG=true
APP_ENV=dev

# Database selection: sqlite or mysql
DATA_SOURCE=sqlite

# SQLite settings (used when DATA_SOURCE=sqlite)
SQLITE_DB_FILE=data/customer_behaviour.db

# MySQL settings (used when DATA_SOURCE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=customer_behavior
MYSQL_SSL_CA=
MYSQL_CONNECT_TIMEOUT=8
MYSQL_READ_TIMEOUT=15
MYSQL_WRITE_TIMEOUT=15
MYSQL_TABLE_BROWSING_HISTORY=browsing_history
MYSQL_TABLE_PURCHASE_PATTERNS=purchase_patterns
MYSQL_TABLE_LOCATION_DATA=location_data
WAKE_SQL_URL=
WAKE_SQL_PROJECT_ID=
WAKE_SQL_INSTANCE_ID=
WAKE_SQL_TIMEOUT_SECONDS=10
WAKE_SQL_POLL_SECONDS=5
WAKE_SQL_VERIFY_SSL=true
WAKE_SQL_CA_BUNDLE_PATH=
WAKE_STATUS_MAX_WAIT_SECONDS=600

# Static asset hosting (optional)
# If STATIC_ASSET_BASE_URL is set, it takes precedence.
# Otherwise asset URL is built from GCS_STATIC_BUCKET and GCS_STATIC_PREFIX.
STATIC_ASSET_BASE_URL=
GCS_STATIC_BUCKET=
GCS_STATIC_PREFIX=static

# Firestore activity tracking (optional)
FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_CREDENTIALS_FILE=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# App-level access control (optional)
# Leave APP_ACCESS_PASSWORD empty to disable password gate.
APP_ACCESS_PASSWORD=
FLASK_SECRET_KEY=change-me

# Session warning banner timing
SESSION_WARNING_DELAY_MINUTES=30
