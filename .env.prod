# Production environment settings
HOST=0.0.0.0
PORT=8080
DEBUG=false
APP_ENV=prod

# Use bucket-backed static assets and CSV data in production
DATA_SOURCE=bucket
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-prod-bucket-name
GCP_BUCKET_DATA_PREFIX=data
STATIC_ASSET_BASE_URL=https://storage.googleapis.com/your-prod-bucket-name/static
