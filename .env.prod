# Production environment settings
HOST=0.0.0.0
PORT=8080
DEBUG=false
APP_ENV=prod

# Use SQL-backed data in production
# DATA_SOURCE=sqlite
# SQLITE_DB_FILE=data/customer_behavior.db
DB_AUTO_BOOTSTRAP_FROM_SQLITE=true

# Or switch to a MySQL server:
DATA_SOURCE=mysql
MYSQL_HOST=136.116.46.215
MYSQL_PORT=3306
MYSQL_USER=customer_behaviour
MYSQL_PASSWORD=012345
MYSQL_DATABASE=customer_behavior
# Optional custom CA file path. Keep empty unless you mount/provide a real cert file.
MYSQL_SSL_CA=
MYSQL_FALLBACK_TO_SQLITE=true
MYSQL_TABLE_BROWSING_HISTORY=browsing_history
MYSQL_TABLE_PURCHASE_PATTERNS=purchase_patterns
MYSQL_TABLE_LOCATION_DATA=location_data

# Serve static assets from GCS in production
GCS_STATIC_BUCKET=your-prod-bucket-name
GCS_STATIC_PREFIX=static
STATIC_ASSET_BASE_URL=https://storage.googleapis.com/your-prod-bucket-name/static

# SQL wake-up function URL (passed to Cloud Function via deployment --env-file)
# Example: https://us-central1-your-project.cloudfunctions.net/wake-sql
WAKE_SQL_URL=https://your-region-your-project.cloudfunctions.net/wake-sql
WAKE_SQL_TIMEOUT_SECONDS=10
